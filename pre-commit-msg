#!/bin/bash
# Git hook: prepare-commit-msg
# Place this file at: .git/hooks/prepare-commit-msg (no extension)

# Get the branch name
BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null)

# Get the JIRA ticket number from the branch name
JIRA_ID=$(echo "$BRANCH_NAME" | grep -Eio '(NXFRAM|NXAC|NXFEED|SIPC|NXLINK|NGMD)-[0-9]+$')

# Define the commit message template
TEMPLATE="# Title: Summary, imperative, start upper case, don't end with a period
# No more than 50 chars. #### 50 chars is here:  #
# Remember blank line between title and body.
# Body: Explain *what* and *why* (not *how*). Include task ID (Jira issue).
# Wrap at 72 chars. ################################## which is here:  #
######## Issue or Ticket Reference ########
${JIRA_ID}
"

# Path to the commit message file
COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Only add template for regular commits (not merges, rebases, etc.)
if [ -z "$COMMIT_SOURCE" ] || [ "$COMMIT_SOURCE" = "template" ]; then
    # Check if the commit message file is empty or contains only comments/whitespace
    if [ ! -s "$COMMIT_MSG_FILE" ] || ! grep -qv '^#' "$COMMIT_MSG_FILE"; then
        echo "$TEMPLATE" > "$COMMIT_MSG_FILE"
    fi
fi
